// File này chứa cấu hình local của Inventory API, bao gồm logging và database riêng.
// Connection string không chứa mật khẩu; môi trường local cung cấp ConnectionStrings__InventoryDb an toàn.
// Gateway Day 49 và Saga Day 52 sẽ kết nối đến Inventory API qua cấu hình này.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InventoryDb": "Host=localhost;Port=5432;Database=shopflow_inventory;Username=shopflow"
  }
}
