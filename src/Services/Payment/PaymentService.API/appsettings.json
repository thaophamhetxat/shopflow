// File này chứa cấu hình local của Payment API, bao gồm logging và database riêng.
// Connection string không chứa mật khẩu; môi trường local cung cấp ConnectionStrings__PaymentDb an toàn.
// Gateway Day 49 và Saga Day 52 sẽ kết nối đến Payment API qua cấu hình này.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentDb": "Host=localhost;Port=5432;Database=shopflow_payment;Username=shopflow"
  }
}
